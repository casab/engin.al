// Cloudflare Workers config for engin.al: an assets-only Worker serving the Eleventy build.
// Connect the GitHub repo in the Cloudflare dashboard (Workers & Pages → Create → Import a repository):
//   Build command:  npm run build:deploy
//   Deploy command: npx wrangler deploy
//   Non-production branch deploy command: npx wrangler versions upload   (preview URL per PR)
// _headers and _redirects inside _site/ are applied by Workers static assets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "engin-al",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
  // Once engin.al's DNS is on Cloudflare (it points at GitHub Pages today), attach the domain:
  // "routes": [{ "pattern": "engin.al", "custom_domain": true }]
}
