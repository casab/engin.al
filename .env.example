# Copy to .env (never committed). Used by `npm run strava:auth` / `npm run strava:sync`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Optional
# STRAVA_RIDE_MIN_KM=100
# STRAVA_TRIM_M=600
# STRAVA_PRIVACY_ZONES=lat,lng,radiusMetres;lat,lng,radiusMetres

# R2 media uploads (`npm run r2:media`)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
