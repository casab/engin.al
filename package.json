{
  "name": "engin.al",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site of Engin Al: things that oscillate.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve --port=8080",
    "clean": "node -e \"fs.rmSync('_site',{recursive:true,force:true})\"",
    "check": "node scripts/check.mjs",
    "strip-metadata": "node scripts/strip-metadata.mjs",
    "r2:media": "node scripts/r2-upload.mjs media",
    "r2:file": "node scripts/r2-upload.mjs file",
    "strava:auth": "node --env-file-if-exists=.env scripts/strava-auth.mjs",
    "strava:sync": "node --env-file-if-exists=.env scripts/strava-sync.mjs",
    "strava:demo": "node scripts/strava-demo.mjs",
    "build:deploy": "npm run clean && eleventy && node scripts/check.mjs --ci",
    "deploy": "npm run build:deploy && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "7.1.1",
    "@11ty/eleventy-plugin-rss": "2.0.4",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@sveltia/cms": "0.262.1",
    "markdown-it": "15.0.3",
    "wrangler": "4.166.0"
  }
}
