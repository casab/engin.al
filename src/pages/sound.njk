---
layout: layouts/base.njk
permalink: /sound/
title: Sound
channel: sound
description: Live synth sets, DJ mixes, Ableton productions, and the instruments on the desk.
---
{%- import "macros.njk" as m -%}
<div class="wrap ch-sound">
  <header class="page-head">
    <span class="label">CH3 / sound</span>
    <h1><span class="sig">sound</span></h1>
    <p class="lede">Live sets on hardware synths, DJ mixes, tracks made in Ableton, and slow progress on guitar, keys and drums.</p>
  </header>

  <section class="section" aria-labelledby="rec-title">
    <div class="head"><p class="label" id="rec-title">recordings &amp; sets</p></div>
    {%- if collections.sound.length %}
    <ul class="sound-list" role="list">
      {%- for s in collections.sound %}
      <li class="sound-item reveal">
        <div class="sound-item__art">
          {%- if s.data.cover %}
          {% image s.data.cover | bundle(s.inputPath), s.data.cover_alt or "", "9rem" %}
          {%- else %}
          {{ m.sigilSvg(s.fileSlug) }}
          {%- endif %}
        </div>
        <div class="stack">
          <p class="meta">{{ s.data.date | date }} · {{ s.data.kind }}{% if s.data.venue %} · {{ s.data.venue }}{% endif %}</p>
          <h3><a href="{{ s.url }}">{{ s.data.title }}</a></h3>
          {%- if s.data.summary %}<p class="meta">{{ s.data.summary }}</p>{% endif %}
          {%- if s.data.embed_url %}{{ m.player({ url: s.data.embed_url, title: s.data.title, bandcamp_id: s.data.bandcamp_id } | player) }}{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="notice">The first recordings are still being bounced. Meanwhile, the scope on the <a href="/">home page</a> doubles as a small synth: switch sound on and play it with your keyboard.</p>
    {%- endif %}
  </section>

  <section class="section" aria-labelledby="rig-title">
    <div class="head">
      <p class="label" id="rig-title">on the desk</p>
      {%- if rig.intro %}<p>{{ rig.intro }}</p>{% endif %}
    </div>
    <ul class="rig" role="list">
      {%- for r in rig.items %}
      <li><span class="label">{{ r.kind }}</span><b>{{ r.name }}</b>{% if r.note %}<p>{{ r.note }}</p>{% endif %}</li>
      {%- endfor %}
    </ul>
  </section>
</div>
