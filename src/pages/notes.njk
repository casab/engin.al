---
layout: layouts/base.njk
permalink: /notes/
title: Notes
description: The occasional longer write-up.
---
<div class="wrap">
  <header class="page-head">
    <p class="label">Notes</p>
    <h1 class="display">Notes</h1>
    <p class="lede">The occasional write-up, when something takes more than a commit message to explain.</p>
  </header>
  <ol class="tracks">
    {%- for n in collections.notes %}
    <li class="track">
      <span class="track__n">{{ n.data.date | date("year") }}</span>
      <span class="track__t"><a href="{{ n.url }}">{{ n.data.title }}</a></span>
      {%- if n.data.description %}<span class="track__m">{{ n.data.description }}</span>{% endif %}
    </li>
    {%- endfor %}
  </ol>
</div>
