---
layout: layouts/base.njk
pagination:
  data: site.lines
  size: 1
  alias: thisLine
permalink: "{{ thisLine.url }}"
eleventyComputed:
  title: "{{ thisLine.label }}"
  line: "{{ thisLine.id }}"
  description: "The {{ thisLine.label }} line: {{ thisLine.long }}"
---
{%- import "macros.njk" as m -%}
{%- set l = thisLine -%}
{%- set list = collections.stations | lineStations(l.id, site.lines) -%}

<div class="wrap c-{{ l.id }}">
  <header class="line-head">
    <div class="line-head__title">
      <span class="badge" aria-hidden="true">{{ l.code }}</span>
      <h1 class="display">{{ l.label }}</h1>
    </div>
    <p class="lede">{{ l.long }} {% if list.length %}{{ list.length }} station{% if list.length != 1 %}s{% endif %} so far.{% endif %}</p>
  </header>

  {%- if list.length %}
  <nav class="strip" aria-label="{{ l.label }} line, oldest to newest">
    <ol>
      {%- for s in list | reverse %}
      <li{% if s.lines.length > 1 %} class="is-x"{% endif %}><a href="#{{ s.id | slugify }}">{{ s.title }}</a></li>
      {%- endfor %}
      <li class="is-now"><a href="/now/">Now</a></li>
    </ol>
  </nav>
  {%- endif %}

  <div class="split split--8-4 section">
    <div>
      {%- if list.length %}
      <ol class="stops">
        {%- for s in list %}
        <li class="stop{% if s.lines.length > 1 %} stop--x{% endif %}" id="{{ s.id | slugify }}">
          <span class="stop__when">{{ s.date | date("month") }}</span>
          <span class="stop__rail" aria-hidden="true"><span class="stop__dot"></span></span>
          <div class="stop__body">
            <div class="stop__title">
              <h2>{% if s.url and s.kind != "race" and s.kind != "ride" %}<a href="{{ s.url }}">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %}</h2>
              <span class="mono muted">{{ s.code }} · {{ s.meta }}{% if s.draft %} · <span class="draft">draft</span>{% endif %}</span>
            </div>
            {%- if s.summary %}<p class="stop__summary">{{ s.summary }}</p>{% endif %}

            {%- if s.embed %}{{ m.player({ url: s.embed, title: s.title, bandcamp_id: s.bandcampId } | player) }}{% endif %}

            {%- if s.activity %}{% set a = s.activity %}
            {%- set g = a.id | route(strava) if a.has_route else null %}
            <div class="route">
              {%- if g %}
              <svg class="trace" viewBox="{{ g.viewBox }}" role="img" aria-label="Route of {{ s.title }}, trimmed at both ends">
                <path d="{{ g.d }}"/><circle class="dot" cx="{{ g.start[0] }}" cy="{{ g.start[1] }}" r="4"/>
              </svg>
              {%- if g.elev %}
              <svg class="elev" viewBox="{{ g.elev.viewBox }}" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="{{ g.elev.area }}"/><path d="{{ g.elev.d }}"/></svg>
              {%- endif %}
              {%- elif s.photo %}
              <figure class="plate">{% image s.photo, s.photoAlt, "26rem" %}</figure>
              {%- endif %}
              <p class="stats"><span><b>{{ a.distance_m | km }}</b> km</span>{% if a.moving_s %}<span><b>{{ a.moving_s | duration }}</b></span><span>{{ a | pace }}</span>{% endif %}{% if a.elev_m %}<span>↑ {{ a.elev_m | round }} m</span>{% endif %}{% if a.race %}<span>race</span>{% endif %}</p>
            </div>
            {%- if s.note %}<div class="stop__summary">{{ s.note | safe }}</div>{% endif %}
            {%- endif %}

            {%- if s.lines.length > 1 %}
            <p class="stop__change"><span class="label">Change here for</span>
              {%- for o in s.lines %}{% if o != l.id %}{% set ol = o | lineInfo(site.lines) %}
              <a class="tag c-{{ ol.id }}" href="{{ ol.url }}"><span class="bar" aria-hidden="true"></span>{{ ol.code }} {{ ol.label }}</a>
              {%- endif %}{% endfor %}
            </p>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>
      {%- else %}
      <p class="lede muted">No stations on this line yet.{% if l.id == "distance" %} Races appear here after the first Strava sync.{% endif %}</p>
      {%- endif %}
    </div>

    <aside class="aside">
      {%- if l.id == "sound" and rig.items and rig.items.length %}
      <section aria-labelledby="rig-title">
        <h2 class="display" id="rig-title">Rolling stock</h2>
        <ul class="rig">
          {%- for r in rig.items %}
          <li><span>{{ r.name }}</span><span class="mono muted">{{ r.kind }}</span>{% if r.note %}<p>{{ r.note }}</p>{% endif %}</li>
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}

      {%- if l.id == "distance" %}
      {%- set weekly = strava.activities.weekly or {} %}
      {%- set years = weekly | weeklyYears %}
      {%- set top = weekly | weeklyMax %}
      {%- if years.length %}
      <section aria-labelledby="weeks-title">
        <h2 class="display" id="weeks-title">Every week</h2>
        <p class="muted">Weekly distance, one trace per year, January on the left. Same scale for every year.</p>
        <div class="legend"><span class="tag"><span class="bar" aria-hidden="true"></span>Run</span><span class="tag ride"><span class="bar" aria-hidden="true"></span>Ride</span></div>
        <div class="years">
          {%- for y in years %}
          {%- set run = weekly[y].run | weeklyTrace({ max: top }) %}{% set ride = weekly[y].ride | weeklyTrace({ max: top }) %}
          <div class="yr">
            <span class="mono">{{ y }}</span>
            <svg viewBox="0 0 1000 120" preserveAspectRatio="none" role="img" aria-label="{{ y }}: {{ weekly[y].run_km or 0 }} km run, {{ weekly[y].ride_km or 0 }} km ridden">
              <path class="base" d="M0 114H1000"/>{% if ride.d %}<path class="ride" d="{{ ride.d }}"/>{% endif %}{% if run.d %}<path d="{{ run.d }}"/>{% endif %}
            </svg>
          </div>
          {%- endfor %}
        </div>
      </section>
      {%- endif %}
      <p class="mono muted">Data powered by <a href="https://www.strava.com" rel="noopener noreferrer">Strava</a>{% if strava.activities.synced_at %} · synced {{ strava.activities.synced_at | date("long") }}{% endif %}. Routes are trimmed at both ends.</p>
      {%- endif %}

      <section aria-labelledby="change-title">
        <h2 class="display" id="change-title">Other lines</h2>
        <ul class="change-list">
          {%- for o in site.lines %}{% if o.id != l.id %}
          <li class="c-{{ o.id }}"><a class="tag" href="{{ o.url }}"><span class="bar" aria-hidden="true"></span>{{ o.code }} {{ o.label }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </section>
    </aside>
  </div>
</div>
