---
layout: layouts/base.njk
permalink: /projects/
title: Projects
description: Backends, drivers, firmware, reverse engineering, games, ML experiments and music tools. A log of things built.
---
{%- import "macros.njk" as m -%}
<div class="wrap">
  <header class="page-head">
    <span class="label">CH1 · CH2 · CH3 / log</span>
    <h1>projects</h1>
    <p class="lede">Things I built, took apart or am still in the middle of. Newest first. Some shipped, some got shelved, and both kinds are listed.</p>
  </header>

  <div class="filterable">
    <fieldset class="filter">
      <legend class="sr-only">Filter by channel</legend>
      <input type="radio" name="ch" id="f-all" value="all" checked><label class="btn" for="f-all">all</label>
      {%- for c in site.channels %}{% if c.id != "distance" %}
      <input type="radio" name="ch" id="f-{{ c.id }}" value="{{ c.id }}"><label class="btn ch-{{ c.id }}" for="f-{{ c.id }}">CH{{ c.ch }} {{ c.label }}</label>
      {%- endif %}{% endfor %}
    </fieldset>

    {%- if collections.projects.length %}
    {%- for year, items in collections.projects | groupByYear %}
    <h2 class="year">{{ year }}</h2>
    <ul class="log" role="list">
      {%- for p in items %}
      {%- set main = (p.data.channels or ["code"])[0] %}
      <li class="row ch-{{ main }}{% for c in p.data.channels %} ch-{{ c }}{% endfor %}">
        <span class="meta">{{ p.data.date | date }}{% if p.data.draft %}<br><span class="chip draft-chip">draft</span>{% endif %}</span>
        <div>
          <h3><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
          {%- if p.data.summary %}<p>{{ p.data.summary }}</p>{% endif %}
          {{ m.chips(p.data.channels, site.channels) }}
        </div>
        <span class="meta row__side">{{ p.data.status or "shipped" }}{% if p.data.stack and p.data.stack.length %} · {{ p.data.stack | limit(2) | join(", ") }}{% endif %}</span>
      </li>
      {%- endfor %}
    </ul>
    {%- endfor %}
    {%- else %}
    <p class="notice">No published projects yet.</p>
    {%- endif %}
  </div>
</div>
