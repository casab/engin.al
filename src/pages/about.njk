---
layout: layouts/base.njk
permalink: /about/
title: Network information
description: Backend developer, electronics engineer by training, synth player and long-distance runner, in Istanbul.
---
{%- import "macros.njk" as m -%}
<div class="wrap">
  <header class="page-head">
    <p class="label">About</p>
    <h1 class="display">Network<br>information</h1>
  </header>
  <div class="split split--7-5">
    <div class="prose">
      {{ about.body | md | safe }}
    </div>
    <div class="aside">
      {%- if about.photo %}
      <figure class="plate portrait">{% image about.photo, about.photo_alt or "", "(min-width: 60rem) 35vw, 100vw" %}</figure>
      {%- endif %}
      <dl class="credits credits--ruled">
        <dt>Operated by</dt><dd>{{ about.operated_by }}</dd>
        <dt>Day job</dt><dd>{{ about.day_job }}</dd>
        <dt>Trained as</dt><dd>{{ about.trained_as }}</dd>
        <dt>Service</dt><dd>{{ about.service }}</dd>
        <dt>Lines</dt><dd>{{ m.tags(["code", "circuits", "sound", "distance"], site.lines) }}</dd>
        {%- for s in site.socials %}
        <dt>{{ s.label }}</dt><dd><a href="{{ s.url }}" rel="me noopener noreferrer">{{ s.url | replace("mailto:", "") | replace("https://", "") | replace("www.", "") }}</a></dd>
        {%- endfor %}
      </dl>
    </div>
  </div>
</div>
