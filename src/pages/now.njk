---
layout: layouts/base.njk
permalink: /now/
title: Now
description: What I'm building, training for and listening to at the moment.
---
{%- import "macros.njk" as m -%}
<div class="wrap">
  <header class="page-head">
    <p class="label">Now · updated {{ now.updated | date("long") }}</p>
    <h1 class="display">Now</h1>
    <p class="lede">What's running on the network at the moment. This page replaces the blog I never wrote.</p>
  </header>
  {%- if now.board and now.board.length %}{{ m.board(now.board, site.lines) }}{% endif %}
  <div class="split split--7-5 section">
    <div class="prose">{{ now.body | md | safe }}</div>
    <dl class="credits credits--ruled">
      {%- if now.building %}<dt>Building</dt><dd>{{ now.building }}</dd>{% endif %}
      {%- if now.training %}<dt>Training for</dt><dd>{{ now.training }}</dd>{% endif %}
      {%- if now.playing %}<dt>Practising</dt><dd>{{ now.playing }}</dd>{% endif %}
      {%- if now.listening %}<dt>On repeat</dt><dd>{{ now.listening }}</dd>{% endif %}
    </dl>
  </div>
</div>
