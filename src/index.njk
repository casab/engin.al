---
layout: layouts/base.njk
permalink: /
---
{%- import "macros.njk" as m -%}
{%- set stations = collections.stations -%}
{%- set xs = stations | interchanges -%}
{%- set featured = null -%}
{%- for s in xs %}{% if not featured and s.featured %}{% set featured = s %}{% endif %}{% endfor -%}
{%- if not featured %}{% set featured = xs | first %}{% endif -%}

<section class="hero wrap split split--7-5" aria-labelledby="hero-title">
  <h1 class="display" id="hero-title">Four lines,<br>one network.</h1>
  <div class="intro">
    {%- for p in site.intro %}<p>{{ p }}</p>{% endfor %}
  </div>
</section>

{{ m.network(stations, site.lines) }}

<div class="wrap section">
  {%- set rows = now.board if now.board and now.board.length else [] -%}
  {%- if rows.length %}{{ m.board(rows, site.lines) }}{% endif %}
</div>

<section class="wrap" aria-label="Lines">
  <div class="lines-index">
    {%- for l in site.lines %}
    {%- set list = stations | lineStations(l.id, site.lines) %}
    <div class="c-{{ l.id }}">
      <div class="lines-index__head">
        <h2 class="display"><a href="{{ l.url }}">{{ l.label }}</a></h2>
        <span class="mono">{{ l.code }}</span>
      </div>
      {%- if list.length %}
      <ol class="tracks">
        {%- for s in list | limit(5) %}
        <li class="track">
          <span class="track__n">{{ s.code }}</span>
          <span class="track__t">{% if s.url %}<a href="{{ s.url }}">{{ s.title }}</a>{% else %}{{ s.title }}{% endif %}</span>
          <span class="track__m">{% if s.lines.length > 1 %}× {% for o in s.lines %}{% if o != l.id %}{{ (o | lineInfo(site.lines)).code }} {% endif %}{% endfor %}· {% endif %}{{ s.meta }}{% if s.draft %} · <span class="draft">draft</span>{% endif %}</span>
        </li>
        {%- endfor %}
      </ol>
      {%- else %}
      <p class="muted">No stations open yet.</p>
      {%- endif %}
      <a class="lines-index__more cta" href="{{ l.url }}">The {{ l.label }} line →</a>
    </div>
    {%- endfor %}
  </div>
</section>

{%- if featured %}
<section class="wrap section">
  <div class="split split--6-5 feature ruled">
    <div class="section">
      {%- if featured.cover %}
      <figure class="plate">{% image featured.cover, featured.coverAlt, "(min-width: 60rem) 50vw, 100vw" %}</figure>
      {%- else %}
      <div class="plate plate--empty c-{{ featured.lines[0] }}" aria-hidden="true"></div>
      {%- endif %}
    </div>
    <div class="feature__text">
      <p class="label">Interchange · {% for l in featured.lines %}{{ (l | lineInfo(site.lines)).code }}{% if not loop.last %} × {% endif %}{% endfor %}</p>
      <h2 class="display">{{ featured.title }}</h2>
      {{ m.tags(featured.lines, site.lines) }}
      {%- if featured.summary %}<p>{{ featured.summary }}</p>{% endif %}
      {%- if featured.data and featured.data.stack and featured.data.stack.length %}
      <dl class="credits credits--ruled">
        <dt>Built with</dt><dd>{{ featured.data.stack | join(", ") }}</dd>
        {%- if featured.data.status %}<dt>Status</dt><dd>{{ featured.data.status }}</dd>{% endif %}
      </dl>
      {%- endif %}
      {%- if featured.url %}<a class="cta" href="{{ featured.url }}">Alight here →</a>{% endif %}
    </div>
  </div>
</section>
{%- endif %}

<section class="wrap section ruled info" aria-labelledby="info-title">
  <h2 class="display" id="info-title">Network<br>information</h2>
  <dl class="credits">
    <dt>Operated by</dt><dd>{{ about.operated_by }}</dd>
    <dt>Day job</dt><dd>{{ about.day_job }}</dd>
    <dt>Trained as</dt><dd>{{ about.trained_as }}</dd>
    <dt>Service</dt><dd>{{ about.service }}</dd>
  </dl>
  <dl class="credits">
    {%- for s in site.socials %}
    <dt>{{ s.label }}</dt><dd><a href="{{ s.url }}" rel="me noopener noreferrer">{{ s.url | replace("mailto:", "") | replace("https://", "") | replace("www.", "") }}</a></dd>
    {%- endfor %}
    <dt>More</dt><dd><a href="/about/">About</a> · <a href="/now/">Now</a></dd>
  </dl>
</section>
