{#- Shared building blocks. Import with: {% import "macros.njk" as m %} -#}

{%- macro chips(ids, channels) -%}
{%- if ids and ids.length -%}
<ul class="chips" aria-label="channels">
  {%- for id in ids %}
  {%- set c = id | channelInfo(channels) %}
  <li class="chip ch-{{ c.id }}">CH{{ c.ch }} {{ c.label }}</li>
  {%- endfor %}
</ul>
{%- endif -%}
{%- endmacro -%}

{%- macro sigilSvg(seed, extraClass="") -%}
{%- set g = seed | sigil -%}
<svg class="sigil {{ extraClass }}" viewBox="{{ g.viewBox }}" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <path class="grat" d="M0 100H320M160 0V200"/>
  <path d="{{ g.d }}"/>
</svg>
{%- endmacro -%}

{%- macro wave(kind, cls="") -%}
{%- set g = kind | channelWave -%}
<svg class="trace draw {{ cls }}" viewBox="{{ g.viewBox }}" preserveAspectRatio="none" aria-hidden="true">
  <path class="glow" pathLength="1" d="{{ g.d }}"/>
  <path pathLength="1" d="{{ g.d }}"/>
</svg>
{%- endmacro -%}

{%- macro projectCard(p, channels) -%}
{%- set main = (p.data.channels or ["code"])[0] -%}
<li class="card ch-{{ main }}">
  <div class="card__art">
    {%- if p.data.cover %}
    {% image p.data.cover | bundle(p.inputPath), p.data.cover_alt or "", "(min-width: 60rem) 33vw, 100vw" %}
    {%- else %}
    {{ sigilSvg(p.fileSlug) }}
    {%- endif %}
  </div>
  <div class="card__body">
    <p class="meta">{{ p.data.date | date("year") }} · {{ p.data.status or "shipped" }}{% if p.data.draft %} · <span class="chip draft-chip">draft</span>{% endif %}</p>
    <h3><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
    {%- if p.data.summary %}<p>{{ p.data.summary }}</p>{% endif %}
    {{ chips(p.data.channels, channels) }}
  </div>
</li>
{%- endmacro -%}

{#- Click-to-load player. Nothing loads from SoundCloud/Mixcloud/Bandcamp/YouTube until a click. -#}
{%- macro player(p) -%}
{%- if p and p.embed -%}
<div class="player player--{{ p.type }}">
  <a class="player__facade" href="{{ p.url }}" data-embed="{{ p.embed }}" data-height="{{ p.height }}" data-video="{{ 'true' if p.video else '' }}" data-title="{{ p.label }}" rel="noopener noreferrer">
    <span class="player__play" aria-hidden="true">▶</span>
    <span>
      <span class="player__label">{{ p.label }}</span>
      <span class="meta">{{ p.type }} · loads the player from {{ p.type }} when clicked</span>
    </span>
  </a>
</div>
{%- elif p -%}
<p><a class="btn" href="{{ p.url }}" rel="noopener noreferrer">listen on {{ p.label }} <span class="arrow">→</span></a></p>
{%- endif -%}
{%- endmacro -%}
