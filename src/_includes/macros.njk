{#- Shared building blocks. Import with: {% import "macros.njk" as m %} -#}

{#- Line tags: a coloured bar + "L2 Circuits" for each line id -#}
{%- macro tags(ids, lines, cls="") -%}
{%- if ids and ids.length -%}
<ul class="tags {{ cls }}" aria-label="Lines">
  {%- for id in ids %}{% set l = id | lineInfo(lines) %}
  <li class="tag c-{{ l.id }}"><span class="bar" aria-hidden="true"></span>{{ l.code }} {{ l.label }}</li>
  {%- endfor %}
</ul>
{%- endif -%}
{%- endmacro -%}

{#- Click-to-load player. Nothing loads from SoundCloud/Mixcloud/Bandcamp/YouTube until a click.
    as: "recording" (my set or track itself) or "tracklist" (a playlist of the tracks I played, by their artists):
    a tag says which, and a tracklist looks different (dashed rules, ≡ instead of ▶). -#}
{%- macro player(p, as) -%}
{%- set list = as == "tracklist" -%}
{%- if p and p.embed -%}
<div class="player c-sound{% if list %} player--list{% endif %}">
  <a class="player__facade" href="{{ p.url }}" data-embed="{{ p.embed }}" data-height="{{ p.height }}" data-video="{{ 'true' if p.video else '' }}" data-title="{{ ('Tracklist: ' if list) + p.label }}" rel="noopener noreferrer">
    <span class="player__play" aria-hidden="true">{{ "≡" if list else "▶" }}</span>
    <span>
      {%- if as %}<span class="player__kind">{{ "Tracklist · not a recording" if list else "Recording" }}</span>{% endif %}
      <span class="player__label">{{ p.label }}</span>
      <span class="mono muted">{% if list %}the tracks I played, by their artists · {% endif %}{{ p.type }} · the player loads from {{ p.type }} when clicked</span>
    </span>
  </a>
</div>
{%- elif p -%}
<p><a class="cta" href="{{ p.url }}" rel="noopener noreferrer">{{ "Tracklist on " if list else "Listen on " }}{{ p.label }} →</a></p>
{%- endif -%}
{%- endmacro -%}

{#- The network map (desktop) and the same stations as a vertical diagram (phones), with a line filter -#}
{#- end: the terminus, { label, url, note } (default: Now). timeline: false hides the year jumps (one-year maps). #}
{%- macro network(stations, lines, end = null, timeline = true, heading = "The network") -%}
{%- set net = stations | network(lines) -%}
{%- set endLabel = end.label if end else "Now" -%}
{%- set endUrl = end.url if end else "/now/" -%}
<section class="network wrap" aria-labelledby="network-title">
  <h2 class="sr-only" id="network-title">{{ heading }}</h2>
  <fieldset class="filter">
    <legend class="sr-only">Show one line</legend>
    <input type="radio" name="line" id="f-all" value="all" checked><label for="f-all"><span class="bar" aria-hidden="true"></span>All lines</label>
    {%- for l in lines %}
    <input type="radio" name="line" id="f-{{ l.id }}" value="{{ l.id }}"><label for="f-{{ l.id }}" class="c-{{ l.id }}"><span class="bar" aria-hidden="true"></span>{{ l.code }} {{ l.label }}</label>
    {%- endfor %}
    <span class="filter__hint mono muted">time runs left to right · {{ net.stations.length }} stations</span>
  </fieldset>

  {#- Year jumps for the map: shown by map.js (they scroll the map), hidden without JS #}
  {%- if timeline and net.years.length > 1 %}
  <div class="timeline" data-timeline hidden>
    <span class="label">Jump to</span>
    <ol>
      {%- for y in net.years %}<li><button type="button" data-map-year="{{ y.label }}">{{ y.label }}</button></li>{% endfor %}
      <li><button type="button" data-map-year="now">Now</button></li>
    </ol>
    <a class="timeline__all" href="/years/">Year by year →</a>
  </div>
  {%- endif %}

  <div class="map{% if net.width > 1400 %} is-wide{% endif %}">
    <svg viewBox="0 0 {{ net.width }} {{ net.height }}" width="{{ net.width }}" height="{{ net.height }}" role="img" aria-labelledby="map-desc">
      <desc id="map-desc">A transit map of {{ net.stations.length }} projects, recordings, milestones and races on {{ lines.length }} line{% if lines.length != 1 %}s{% endif %}: {% for l in lines %}{{ l.label }}{% if not loop.last %}, {% endif %}{% endfor %}. The same stations are listed below the map on small screens and on each line's page.</desc>
      <path class="axis" d="M0 {{ net.axisY }}H{{ net.width }}"/>
      {%- for y in net.years %}<text class="year" x="{{ y.x }}" y="{{ net.axisY + 20 }}" text-anchor="middle">{{ y.label }}</text>{% endfor %}
      {%- for p in net.paths %}
      <g class="ln c-{{ p.id }}"><path pathLength="1" d="{{ p.d }}"/></g>
      {%- endfor %}
      {%- for s in net.stations %}
      <g class="st{% if s.interchange %} st--x{% endif %}{% if s.minor %} st--minor{% endif %}{% if s.draft %} st--draft{% endif %}{% for l in s.lines %} on-{{ l }}{% endfor %}" data-st="{{ loop.index0 }}" data-year="{{ s.year }}">
        {%- set when = s.range or (s.date | date('month')) %}
        {%- if s.url %}<a href="{{ s.url }}" aria-label="{{ s.title }}, {{ when }}">{% else %}<g class="st__plain" role="img" aria-label="{{ s.title }}, {{ when }}">{% endif %}
        {%- if s.pill %}<rect x="{{ s.pill.x }}" y="{{ s.pill.y }}" width="{{ s.pill.w }}" height="{{ s.pill.h }}" rx="12"/>{% else %}<circle cx="{{ s.x }}" cy="{{ s.y }}" r="7"/><circle class="hit" cx="{{ s.x }}" cy="{{ s.y }}" r="18"/>{% endif %}
        <text x="{{ s.label.x }}" y="{{ s.label.y }}" text-anchor="middle">{{ s.text }}</text>
        {%- if s.url %}</a>{% else %}</g>{% endif %}
      </g>
      {%- endfor %}
      {#- periods (jobs, degrees) on the time axis: start dot, bar, an end tick or an arrow while it runs -#}
      {%- for b in net.bars %}
      <g class="span c-{{ b.line }}{% for l in b.lines %} on-{{ l }}{% endfor %}{% if b.open %} span--open{% endif %}" aria-hidden="true">
        <path d="M{{ b.x1 }} {{ b.y }}H{{ b.x2 }}"/>
        <path class="span__tip" d="{% if b.open %}M{{ b.x2 - 7 }} {{ b.y - 7 }}L{{ b.x2 + 1 }} {{ b.y }}L{{ b.x2 - 7 }} {{ b.y + 7 }}{% else %}M{{ b.x2 }} {{ b.y - 7 }}V{{ b.y + 7 }}{% endif %}"/>
        <circle cx="{{ b.x1 }}" cy="{{ b.y }}" r="4.5"/>
        <text x="{{ b.x1 - 4 }}" y="{{ b.y - 11 }}">{{ b.text }}</text>
        {%- if b.endText %}<text x="{{ b.x2 - 12 }}" y="{{ b.y - 11 }}" text-anchor="end">{{ b.endText }}</text>{% endif %}
      </g>
      {%- endfor %}
      {%- if end %}<a class="hub" href="{{ endUrl }}" aria-label="{{ end.note or endLabel }}">{% else %}<g class="hub">{% endif %}
        <rect x="{{ net.hub.x }}" y="{{ net.hub.y }}" width="{{ net.hub.w }}" height="{{ net.hub.h }}" rx="17"/>
        <text x="{{ net.hub.labelX }}" y="{{ net.hub.labelY }}">{{ endLabel | upper }}</text>
      {%- if end %}</a>{% else %}</g>{% endif %}
    </svg>
  </div>
  <div class="map-card" data-map-card hidden></div>
  <script type="application/json" data-map-data>{{ net.stations | mapCards(lines) | json | safe }}</script>

  <ol class="diagram" aria-label="Stations, newest first">
    <li class="diagram__row diagram__row--now{% for l in lines %} on-{{ l.id }}{% endfor %}">
      {%- for l in lines %}<span class="diagram__cell c-{{ l.id }}" aria-hidden="true"><span class="diagram__dot"></span></span>{% endfor %}
      <span class="diagram__text"><a class="diagram__title" href="{{ endUrl }}">{{ endLabel }}</a><span class="mono muted">{{ end.note if end and end.note else "all lines" }}</span></span>
    </li>
    {%- for s in stations %}
    <li class="diagram__row{% if loop.index > 12 %} is-more{% endif %}{% for l in s.lines %} on-{{ l }}{% endfor %}">
      {%- for l in lines %}<span class="diagram__cell c-{{ l.id }}" aria-hidden="true">{% if l.id in s.lines %}<span class="diagram__dot"></span>{% endif %}</span>{% endfor %}
      <span class="diagram__text">
        {%- if s.url %}<a class="diagram__title" href="{{ s.url }}">{{ s.title }}</a>{% else %}<span class="diagram__title">{{ s.title }}</span>{% endif %}
        <span class="mono muted">{% if s.lines.length > 1 %}interchange {% for l in s.lines %}{{ (l | lineInfo(lines)).code }}{% if not loop.last %} · {% endif %}{% endfor %}{% else %}{{ (s.lines[0] | lineInfo(lines)).code }} · {{ s.meta }}{% endif %}{% if s.draft %} · <span class="draft">draft</span>{% endif %}</span>
      </span>
    </li>
    {%- endfor %}
  </ol>
  {%- if stations.length > 12 %}
  {#- Phones show the newest 12; this CSS-only toggle shows the rest (a line filter shows all of that line). #}
  <input class="diagram__all-input" type="checkbox" id="d-all">
  <label class="diagram__all cta" for="d-all"><span class="when-closed">Show all {{ stations.length }} stations</span><span class="when-open">Show the latest 12</span></label>
  {%- endif %}
</section>
{%- endmacro -%}

{#- The departures board. Rows come from the Now page (CMS); text is real HTML, the flip is decoration -#}
{%- macro board(rows, lines) -%}
<section class="board" aria-labelledby="board-title">
  <div>
    <h2 class="flaps" id="board-title" aria-label="Departures" data-flap>
      {%- for ch in "DEPARTURES" %}<span class="flap" aria-hidden="true">{{ ch }}</span>{% endfor -%}
    </h2>
    <p class="board__note">Updated from the <a href="/now/">Now page</a></p>
  </div>
  <div class="board__rows">
    {%- for b in rows %}{% set l = b.line | lineInfo(lines) %}
    <span class="c-{{ l.id }}"><span class="bar" aria-hidden="true"></span><span class="sr-only">{{ l.code }} {{ l.label }}</span></span>
    <span>{% if b.url %}<a href="{{ b.url }}">{{ b.destination }}</a>{% else %}{{ b.destination }}{% endif %}</span>
    <span class="when">{{ b.when }}</span>
    <span class="status">{{ b.status }}</span>
    {%- endfor %}
  </div>
</section>
{%- endmacro -%}

{#- Station pages: one strip per line the entry is on, with the stations either side of it on that line. -#}
{%- macro nextStops(stops) -%}
{%- if stops.length %}
<nav class="wrap next-stops" aria-label="Next stops">
  <h2 class="label">Next stops</h2>
  {%- for st in stops %}
  <section class="stopnav c-{{ st.line.id }}" aria-label="{{ st.line.label }} line">
    <a class="stopnav__line" href="{{ st.line.url }}"><span class="badge" aria-hidden="true">{{ st.line.code }}</span><span><span class="stopnav__name">{{ st.line.label }}</span> <span class="mono muted">station {{ st.n }} of {{ st.total }}</span></span></a>
    <div class="stopnav__rail">
      {%- for dir in ["older", "newer"] %}{% set s = st[dir] %}
      {%- if s %}
      {%- set label %}<span class="mono muted">{% if dir == "older" %}← older · {% endif %}{{ s.range if s.range else (s.date | date("month")) }}{% if dir == "newer" %} · newer →{% endif %}</span><span class="stopnav__t">{{ s.title }}</span>{% endset %}
      {%- if s.url %}<a class="stopnav__stop stopnav__stop--{{ dir }}" href="{{ s.url }}"{% if s.url.startsWith("http") %} rel="noopener noreferrer"{% endif %}>{{ label | safe }}</a>
      {%- else %}<span class="stopnav__stop stopnav__stop--{{ dir }}">{{ label | safe }}</span>{% endif %}
      {%- else %}
      <span class="stopnav__stop stopnav__stop--{{ dir }} stopnav__stop--end"><span class="mono muted">{% if dir == "older" %}first station on the line{% else %}newest station on the line{% endif %}</span></span>
      {%- endif %}
      {%- endfor %}
    </div>
  </section>
  {%- endfor %}
</nav>
{%- endif %}
{%- endmacro -%}
