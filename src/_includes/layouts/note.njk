---
layout: layouts/base.njk
---
<article>
  <header class="wrap page-head">
    <div class="lp-head__top"><a class="label" href="/notes/">← Notes</a><button class="share" type="button" data-share hidden>Share</button></div>
    <h1 class="display">{{ title }}</h1>
    <p class="mono muted">{{ date | date("long") }}{% if tags and tags.length %} · {{ tags | join(" · ") }}{% endif %}</p>
    {%- if description %}<p class="lede">{{ description }}</p>{% endif %}
  </header>
  <div class="wrap split split--3-9">
    <span></span>
    <div class="prose">{{ content | safe }}</div>
  </div>
</article>
