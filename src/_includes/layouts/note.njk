---
layout: layouts/base.njk
---
<article class="narrow">
  <header class="page-head">
    <a class="label" href="/notes/">← notes</a>
    <h1>{{ title }}</h1>
    <p class="meta">{{ date | date("long") }}{% if tags and tags.length %} · {{ tags | join(" · ") }}{% endif %}</p>
    {%- if description %}<p class="lede">{{ description }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
