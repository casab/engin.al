---
layout: layouts/base.njk
---
<div class="wrap">
  <header class="page-head">
    {%- if eyebrow %}<span class="label">{{ eyebrow }}</span>{% endif %}
    <h1>{{ heading or title }}</h1>
    {%- if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  {%- if updated %}
  <p class="meta updated">last updated {{ updated | date("long") }}</p>
  {%- endif %}
</div>
