{%- set pageTitle = (title + " · " + site.title) if title and page.url != "/" else (site.title + ": " + site.tagline) -%}
{%- set pageDesc = (description or summary or site.description) | stripHtml -%}
{%- set ogImage = (cover | bundle(page.inputPath) | mediaOg) if cover else site.og_image -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="theme-color" content="#EDEDE8">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  <link rel="preload" href="/assets/fonts/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
  <meta property="og:type" content="{{ 'article' if date and page.url != '/' else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:image" content="{{ ogImage | absoluteUrl(site.url) }}">
  <meta name="twitter:card" content="summary_large_image">
  <script type="module" src="/assets/js/site.js"></script>
</head>
<body{% if line %} class="c-{{ line }}"{% endif %}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/" aria-label="engin.al, home">
        {% include "logo.svg.njk" %}
        <span>ENGIN AL</span>
      </a>
      <nav class="nav" aria-label="Main">
        <ul>
          {%- for item in site.nav %}
          <li{% if item.line %} class="c-{{ item.line }}"{% endif %}><a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{% if item.line %}<span class="bar" aria-hidden="true"></span>{% endif %}{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap mono muted">
      <span>Map drawn at build time from the content · Eleventy · No tracking · <a href="/feed.xml">feed</a> · <a href="https://github.com/casab/engin.al" rel="noopener noreferrer">source</a></span>
      <span>{% for s in site.socials %}<a href="{{ s.url }}" rel="me noopener noreferrer">{{ s.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>
    </div>
  </footer>
</body>
</html>
