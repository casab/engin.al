{%- set pageTitle = (title + " · " + site.title) if title and page.url != "/" else (site.title + ": " + site.tagline) -%}
{%- set pageDesc = (description or summary or site.description) | stripHtml -%}
{%- set ogImage = (cover | bundle(page.inputPath) | mediaOg) if cover else site.og_image -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="theme-color" content="#EDEDE8">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  <link rel="preload" href="/assets/fonts/archivo-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
  <meta property="og:type" content="{{ 'article' if date and page.url != '/' else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:image" content="{{ ogImage | absoluteUrl(site.url) }}">
  <meta name="twitter:card" content="summary_large_image">
  <script type="module" src="/assets/js/site.js"></script>
</head>
<body{% if line %} class="c-{{ line }}"{% endif %}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/" aria-label="engin.al, home">
        {% include "logo.svg.njk" %}
        <span>ENGIN AL</span>
      </a>
      <nav class="nav" aria-label="Main">
        <ul>
          {%- for item in site.nav %}
          <li{% if item.line %} class="c-{{ item.line }}"{% endif %}><a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{% if item.line %}<span class="bar" aria-hidden="true"></span>{% endif %}{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      {#- Search: a link to /search/ without JS; site.js opens the search dialog instead (also Ctrl/Cmd+K and /) #}
      <a class="search-btn" href="/search/" data-search-open aria-keyshortcuts="Control+K Meta+K /"{% if page.url == "/search/" %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="6.5" cy="6.5" r="4.75" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 10l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
        <span>Search</span><kbd class="search-btn__key" data-search-key hidden>Ctrl K</kbd>
      </a>
      {#- Phones: the same menu as a full-screen sheet. <details> keeps it working without JS. #}
      <details class="menu" data-menu>
        <summary class="menu__btn"><span class="menu__open">Menu</span><span class="menu__close">Close</span></summary>
        <nav class="menu__sheet" aria-label="Main menu">
          <ul class="menu__lines">
            {%- for l in site.lines %}{% set n = (collections.stations | lineStations(l.id, site.lines)).length %}
            <li class="c-{{ l.id }}"><a href="{{ l.url }}"{% if page.url and page.url.startsWith(l.url) %} aria-current="page"{% endif %}><span class="bar" aria-hidden="true"></span><span class="menu__name">{{ l.label }}</span><span class="mono muted">{{ l.code }} · {{ n }} station{% if n != 1 %}s{% endif %}</span></a></li>
            {%- endfor %}
          </ul>
          <ul class="menu__more">
            {%- for item in site.nav %}{% if not item.line %}
            <li><a href="{{ item.url }}"{% if page.url and page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {%- endif %}{% endfor %}
            <li><a href="/">The map</a></li>
            <li><a href="/search/" data-search-open>Search</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap mono muted">
      <p>Map drawn at build time from the content · Eleventy · No tracking</p>
      <ul class="footer-links">
        <li><a href="/feed.xml">Feed</a></li>
        <li><a href="https://github.com/casab/engin.al" rel="noopener noreferrer">Source</a></li>
        {%- for s in site.socials %}<li><a href="{{ s.url }}" rel="me noopener noreferrer">{{ s.label }}</a></li>{% endfor %}
      </ul>
    </div>
  </footer>
</body>
</html>
